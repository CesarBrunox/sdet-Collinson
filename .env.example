# Reference configuration only. The suite reads real environment variables (process.env);
# it does NOT load a .env file automatically. Set them in your shell, e.g.
#   bash:       export API_BASE_URL=http://localhost:3000
#   PowerShell: $env:API_BASE_URL = 'http://localhost:3000'

# Base URL of the Activity Ranking API under test
API_BASE_URL=http://localhost:3000
# Port of the suite's Open-Meteo stub. Start the API with
#   OPEN_METEO_GEOCODING_BASE_URL=http://localhost:4010
#   OPEN_METEO_FORECAST_BASE_URL=http://localhost:4010
OPEN_METEO_STUB_PORT=4010
# Per-request timeout (ms) of the test client
API_TIMEOUT_MS=5000
# Reference "now" for the 7-day horizon only; start the API with CLOCK_NOW set to the same instant
REFERENCE_NOW=2026-11-02T22:30:00Z
